# Free public testnet demo. Local mode uses pnpm local:chain / local:web.
EXECUTION_MODE=testnet
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=.local/base-sepolia.sqlite
RPC_URL=https://sepolia.base.org
CONFIRMATIONS=2
BOND_CONTRACT_ADDRESS=
TEST_EXECUTION_ADDRESS=
# 1 faucet USDC, six decimals.
AGENT_BOND_AMOUNT=1000000
AGENT_PRIVATE_KEY=
SETTLEMENT_PRIVATE_KEY=
# Deployment only; remove from running server environment afterward.
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# No 1inch key, Bazantic payment grant, or paid trace RPC needed.
